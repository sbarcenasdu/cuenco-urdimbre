<script>
  // Lógica para manejar los slides
  let currentSlide = 0;
  const slider = document.getElementById('podcastSlider');
  const dots = [document.getElementById('dot1'), document.getElementById('dot2')];

  // Esta función actualiza la posición del slider y los puntos de navegación.
  function updateSlider() {
    // Movemos el slider a la posición correspondiente según currentSlide
    slider.style.transform = `translateX(-${currentSlide * 50}%)`;

    // Actualizamos el color de los puntos de navegación
    dots.forEach((dot, index) => {
      dot.style.backgroundColor = index === currentSlide ? '#4B5563' : '#D1D5DB';
    });
  }

  // Función para ir al siguiente slide
  function nextSlide() {
    currentSlide = (currentSlide + 1) % 2; // Hay solo 2 slides, alterna entre 0 y 1
    updateSlider();
  }

  // Función para ir al slide anterior
  function prevSlide() {
    currentSlide = (currentSlide - 1 + 2) % 2; // Asegura que al restar no se vuelva negativo
    updateSlider();
  }

  // Función para ir a un slide específico usando el índice
  function goToSlide(index) {
    currentSlide = index;
    updateSlider();
  }

  // Inicializa la visualización del slider
  updateSlider();

  // Agregamos los eventos de clic a los botones
  document.getElementById('nextSlide').addEventListener('click', nextSlide);
  document.getElementById('prevSlide').addEventListener('click', prevSlide);

  // Agregar los eventos a los puntos de navegación
  dots.forEach((dot, index) => {
    dot.addEventListener('click', () => goToSlide(index));
  });
</script>


