---
const { id, class: className } = Astro.props;
---

<div class="flex flex-col items-center text-xl mx-2 md:mx-auto ${className} mb-10">
  
    <!-- Sección de Contacto Mejorada -->
    <div class="flex flex-col items-center justify-center mt-10 px-6">
        <div class="bg-white p-8 rounded-2xl shadow-lg border border-gray-300 max-w-2xl text-center relative">

            <!-- Botón de contacto mejorado -->
            <div class="flex items-center gap-3 justify-center">

                <a href="mailto:cuenco_nal@unal.edu.co?subject=Contacto%20desde%20tu%20sitio%20web"
                class="bg-[#681b54] py-3 px-6 font-semibold text-white rounded-lg sm:w-fit hover:scale-105 hover:bg-gray-700 focus:ring-4 focus:outline-none focus:ring-primary-300 transition-transform duration-300 flex items-center gap-2 shadow-lg"
                aria-label="Abrir enlace de contacto">
                    ✉️ Enviar correo
                </a>

            </div>
        </div>
    </div>


</div>



