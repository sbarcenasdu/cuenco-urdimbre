---
const { class: className } = Astro.props;
---


<div class="relative flex flex-col justify-center items-center min-h-[70vh] sm:min-h-screen">
  <!-- Capa de fondo con video -->
  <div class="absolute inset-0 h-full w-full overflow-hidden">
    <video autoplay muted loop class="h-full w-full object-cover opacity-50">
      <source src="/img-cuenco/fondo_grafo.mp4" type="video/mp4">
    </video>
    <div class="absolute inset-0 bg-black bg-opacity-0"></div>
  </div>

  <!-- Botón para desplegar filtros -->
  <div class="absolute top-4 right-4 z-30">
    <button id="toggle-filters" class="bg-[#3C499E] text-white p-2 rounded shadow">
      Filtrar Nodos
    </button>
  </div>
  
  <!-- Filtros -->
  <div id="filter-menu" class="absolute top-4 right-4 z-20 bg-white p-4 rounded shadow w-11/12 sm:w-72 lg:w-80 max-w-sm hidden">
    <h3 class="font-semibold text-center text-sm sm:text-base">Filtrar Nodos</h3>
    <div class="space-y-1">
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Sede Bogotá" checked />
        Sede Bogotá
      </label>
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Sede Medellín" checked />
        Sede Medellín
      </label>
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Sede Manizales" checked />
        Sede Manizales
      </label>
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Sede Palmira" checked />
        Sede Palmira
      </label>
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Sede Tumaco" checked />
        Sede Tumaco
      </label>
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Sede La Paz" checked />
        Sede La Paz
      </label>
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Sede Amazonía" checked />
        Sede Amazonía
      </label>
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Sede Orinoquía" checked />
        Sede Orinoquía
      </label>
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Sede Caribe" checked />
        Sede Caribe
      </label>
      <label class="block text-xs sm:text-sm">
        <input type="checkbox" class="filter" value="Nivel Central" checked />
        Nivel Central
      </label>
    </div>
    <button id="reset-filters" class="mt-2 bg-[#3C499E] text-white py-1 px-2 rounded w-full text-xs sm:text-sm">Restablecer Filtros</button>
  </div>
  
  <!-- JavaScript para control del desplegable -->
  <script>
    // Mostrar/Ocultar el menú de filtros y el botón de filtro
    document.getElementById('toggle-filters').addEventListener('click', function(event) {
      const filterMenu = document.getElementById('filter-menu');
      const toggleButton = document.getElementById('toggle-filters');
      
      // Alternar la visibilidad del menú de filtros
      filterMenu.classList.toggle('hidden');
      
      // Alternar la visibilidad del botón "Filtrar Nodos"
      toggleButton.classList.toggle('hidden');
      
      // Prevenir la propagación del clic en el botón de "Filtrar Nodos"
      event.stopPropagation();
    });
  
    // Cerrar el menú si se hace clic fuera de él
    document.addEventListener('click', function(event) {
      const filterMenu = document.getElementById('filter-menu');
      const toggleButton = document.getElementById('toggle-filters');

      // Aseguramos que `event.target` sea tratado como un `Node` usando un cast
      const target = event.target as Node;

      // Si el clic no es dentro del menú de filtros ni en el botón de filtro, ocultar el menú
      if (filterMenu && toggleButton && !filterMenu.contains(target) && !toggleButton.contains(target)) {
        filterMenu.classList.add('hidden');
        toggleButton.classList.remove('hidden');
      }
    });
  </script>
  


  <!-- Imagen del mapa -->
  <div class="relative w-full max-w-full h-auto z-10 mt-8 px-4">
    <img src="/img-cuenco/Mapa-colombia.png" alt="Mapa de Colombia" class="w-full h-auto object-contain" />
    
    <!-- SVG para las aristas -->
    <svg class="absolute top-0 left-0 w-full h-full pointer-events-none" xmlns="http://www.w3.org/2000/svg">
      <!-- Amazonía -->
      <line x1="63.5%" y1="90%" x2="60%" y2="35%" stroke="black" stroke-width="1" /> <!-- Amazonía a Orinoquía -->
      
      <!-- Bogotá -->
      <line x1="44.2%" y1="43.5%" x2="48.5%" y2="16%" stroke="black" stroke-width="1" /> <!-- Bogotá a La Paz -->
      <line x1="44.2%" y1="43.5%" x2="37.6%" y2="36%" stroke="black" stroke-width="1" /> <!-- Bogotá a Medellín -->
      <line x1="44.2%" y1="43.5%" x2="22.6%" y2="9.8%" stroke="black" stroke-width="1" /> <!-- Bogotá a Caribe -->
      <line x1="44.2%" y1="43.5%" x2="33.5%" y2="51.5%" stroke="black" stroke-width="1" /> <!-- Bogotá a Palmira -->
      <line x1="44.2%" y1="43.5%" x2="23.3%" y2="63.2%" stroke="black" stroke-width="1" /> <!-- Bogotá a Tumaco -->
      
      <!-- Caribe -->
      <line x1="22.6%" y1="9.8%" x2="37.6%" y2="36%" stroke="black" stroke-width="1" /> <!-- Caribe a Medellín -->
      <line x1="22.6%" y1="9.8%" x2="33.5%" y2="51.5%" stroke="black" stroke-width="1" /> <!-- Caribe a Palmira -->
      <line x1="22.6%" y1="9.8%" x2="44.2%" y2="43.5%" stroke="black" stroke-width="1" /> <!-- Caribe a Bogotá -->
      
      <!-- La Paz -->
      <line x1="48.5%" y1="16%" x2="63.5%" y2="90%" stroke="black" stroke-width="1" /> <!-- La Paz a Amazonía -->
      <line x1="48.5%" y1="16%" x2="44.2%" y2="43.5%" stroke="black" stroke-width="1" /> <!-- La Paz a Bogotá -->
      
      <!-- Manizales -->
      <line x1="38%" y1="42.6%" x2="44.2%" y2="43.5%" stroke="black" stroke-width="1" /> <!-- Manizales a Bogotá -->
      <line x1="38%" y1="42.6%" x2="33.5%" y2="51.5%" stroke="black" stroke-width="1" /> <!-- Manizales a Palmira -->
      <line x1="38%" y1="42.6%" x2="37.6%" y2="36%" stroke="black" stroke-width="1" /> <!-- Manizales a Medellín -->
      
      <!-- Medellín -->
      <line x1="37.6%" y1="36%" x2="60%" y2="35%" stroke="black" stroke-width="1" /> <!-- Medellín a Orinoquía -->
      <line x1="37.6%" y1="36%" x2="44.2%" y2="43.5%" stroke="black" stroke-width="1" /> <!-- Medellín a Bogotá -->
      
      <!-- Orinoquía -->
      <line x1="60%" y1="35%" x2="63.5%" y2="90%" stroke="black" stroke-width="1" /> <!-- Orinoquía a Amazonía -->
      <line x1="60%" y1="35%" x2="37.6%" y2="36%" stroke="black" stroke-width="1" /> <!-- Orinoquía a Medellín -->
      <line x1="60%" y1="35%" x2="44.2%" y2="43.5%" stroke="black" stroke-width="1" /> <!-- Orinoquía a Bogotá -->
      
      <!-- Palmira -->
      <line x1="33.5%" y1="51.5%" x2="63.5%" y2="90%" stroke="black" stroke-width="1" /> <!-- Palmira a Amazonía -->
      <line x1="33.5%" y1="51.5%" x2="44.2%" y2="43.5%" stroke="black" stroke-width="1" /> <!-- Palmira a Bogotá -->
      <line x1="33.5%" y1="51.5%" x2="37.6%" y2="36%" stroke="black" stroke-width="1" /> <!-- Palmira a Medellín -->
      
      <!-- Tumaco -->
      <line x1="23.3%" y1="63.2%" x2="33.5%" y2="51.5%" stroke="black" stroke-width="1" /> <!-- Tumaco a Palmira -->
      <line x1="23.3%" y1="63.2%" x2="38%" y2="42.6%" stroke="black" stroke-width="1" /> <!-- Tumaco a Manizales -->
      <line x1="23.3%" y1="63.2%" x2="60%" y2="35%" stroke="black" stroke-width="1" /> <!-- Tumaco a Orinoquía -->

      <!-- Conexiones del Nivel Central a las sedes -->
      <line x1="50%" y1="50%" x2="44.2%" y2="43.5%" stroke="black" stroke-width="1" /> <!-- Nivel Central a Bogotá -->
      <line x1="50%" y1="50%" x2="38%" y2="42.6%" stroke="black" stroke-width="1" /> <!-- Nivel Central a Manizales -->
      <line x1="50%" y1="50%" x2="37.6%" y2="36%" stroke="black" stroke-width="1" /> <!-- Nivel Central a Medellín -->
      <line x1="50%" y1="50%" x2="22.6%" y2="9.8%" stroke="black" stroke-width="1" /> <!-- Nivel Central a Caribe -->
      <line x1="50%" y1="50%" x2="33.5%" y2="51.5%" stroke="black" stroke-width="1" /> <!-- Nivel Central a Palmira -->
      <line x1="50%" y1="50%" x2="23.3%" y2="63.2%" stroke="black" stroke-width="1" /> <!-- Nivel Central a Tumaco -->
      <line x1="50%" y1="50%" x2="60%" y2="35%" stroke="black" stroke-width="1" /> <!-- Nivel Central a Orinoquía -->
      <line x1="50%" y1="50%" x2="48.5%" y2="16%" stroke="black" stroke-width="1" /> <!-- Nivel Central a La Paz -->
      <line x1="50%" y1="50%" x2="63.5%" y2="90%" stroke="black" stroke-width="1" /> <!-- Nivel Central a Amazonía -->
    </svg>
    
  
    <!-- Nodos del grafo sobre el mapa -->
    <div class="absolute top-[89%] left-[62.5%] bg-[#3C499E] w-6 h-6 rounded-full nodo" data-region="Sede Amazonía" data-relations="Sede 4 Encuentro Intersedes., Red para la enseñanza de las matemáticas."></div>
    <div class="absolute top-[34%] left-[59.8%] bg-[#3C499E] w-5 h-5 rounded-full nodo" data-region="Sede Orinoquía" data-relations="Impacto de la experiencia del Semillero de investigación Germinando Curiosidades."></div>
    <div class="absolute top-[15.5%] left-[47.8%] bg-[#3C499E] w-5 h-5 rounded-full nodo" data-region="Sede La Paz" data-relations="Red para la enseñanza de las matemáticas., Diálogos entre Dependencias y colectivos."></div>
    <div class="absolute top-[9%] left-[21.8%] bg-[#3C499E] w-5 h-5 rounded-full nodo" data-region="Sede Caribe" data-relations="Sede 5 Encuentro Intersedes., Red para la enseñanza de las matemáticas Canal de olas."></div>
    <div class="absolute top-[35.5%] left-[37%] bg-[#3C499E] w-5 h-5 rounded-full nodo" data-region="Sede Medellín" data-relations="Diálogos entre Dependencias y colectivos., Red para la enseñanza de las matemáticas Entrenadores Evaluación"></div>
    <div class="absolute top-[42%] left-[37.5%] bg-[#3C499E] w-6 h-6 rounded-full nodo" data-region="Sede Manizales" data-relations="Sede 3 y 9 Encuentro Intersedes., Proyecto Componente 614-C7 BPUN., Red para la enseñanza de las matemáticas., Diálogos entre Dependencias y colectivos sobre inclusión equidad y diversidad., Diálogos entre Dependencias y colectivos., Piloto Repositorio de datos., Diálogos entre Dependencias y colectivos Celebración Día de la Calidad Articulación 9 Encuentro."></div>
    <div class="absolute top-[43%] left-[43.5%] bg-[#3C499E] w-8 h-8 rounded-full nodo" data-region="Sede Bogotá" data-relations="Conceptualización sobre investigación en educación y definición de Líneas de investigación en Educación para la implementación de Cuenco., Producción audiovisual., Conceptualización sobre políticas públicas en educación y definición de Líneas de investigación en Políticas Públicas de Educación Superior para la implementación de Cuenco., Diálogos entre Dependencias y colectivos sobre inclusión equidad y diversidad., Diálogos entre Dependencias y colectivos., Red para la enseñanza de las matemáticas., Enseñanza de las artes para la formación docente en Sedes de Presencia Nacional."></div>
    <div class="absolute top-[51%] left-[33%] bg-[#3C499E] w-5 h-5 rounded-full nodo" data-region="Sede Palmira" data-relations="Productos académicos Una mirada a los territorios de las Sedes de Presencia Nacional., Diálogos entre Dependencias y colectivos., Red para la enseñanza de las matemáticas."></div>
    <div class="absolute top-[62%] left-[23%] bg-[#3C499E] w-5 h-5 rounded-full nodo" data-region="Sede Tumaco" data-relations="Sede del 8 y participación en 7; 8 y 9 Encuentro Intersedes"></div>
    <div class="absolute top-[48%] left-[48%] bg-[#a52984] w-10 h-10 rounded-full nodo" data-region="Nivel Central" data-relations="Conformación y consolidación de un Instituto Nacional de Investigación Innovación y Política Educativa., Reflexiones sobre el Marco Nacional de Cualificaciones: oportunidades; desafíos y perspectivas Articulación 9 Encuentro., Diálogos entre Dependencias y colectivos Futura formación permanente de docentes y formación de docentes de reciente ingreso., Diálogos entre Dependencias y colectivos., Piloto Repositorio de Datos., Red para la enseñanza de las matemáticas Entrenadores Evaluación., Conceptualización sobre innovación en la UNAL para la implementación de Cuenco."></div>

    <!-- Tooltip -->
    <div id="tooltip" class="absolute hidden bg-gray-100 bg-opacity-50 border border-gray-100 p-2 rounded shadow"></div>
  </div>
</div>

<!-- Modal -->
<div id="modal" class="fixed inset-0 z-20 hidden justify-center items-center bg-black bg-opacity-50 transition-opacity duration-300 opacity-0 pointer-events-none">
  <div class="bg-white rounded-lg p-4 max-w-sm w-full">
    <h2 id="modal-title" class="text-lg font-semibold"></h2>
    <ul id="modal-relations" class="mt-2 list-disc pl-5"></ul>
    <button id="close-modal" class="mt-4 bg-[#3C499E] text-white py-2 px-4 rounded">Cerrar</button>
  </div>
</div>

<script>
  const nodos = document.querySelectorAll('.nodo');
  const tooltip = document.getElementById('tooltip');
  const modal = document.getElementById('modal');
  const modalTitle = document.getElementById('modal-title');
  const modalRelations = document.getElementById('modal-relations');
  const closeModal = document.getElementById('close-modal');

  nodos.forEach(nodo => {
    nodo.addEventListener('mouseover', (event) => {
      const region = nodo.getAttribute('data-region');
      tooltip.innerText = region;

      const htmlNodo = nodo as HTMLElement;
      tooltip.style.left = `${htmlNodo.offsetLeft + htmlNodo.offsetWidth + 5}px`;
      tooltip.style.top = `${htmlNodo.offsetTop}px`;
      
      tooltip.classList.remove('hidden');
    });

    nodo.addEventListener('mouseout', () => {
      tooltip.classList.add('hidden');
    });

    nodo.addEventListener('click', () => {
      const region = nodo.getAttribute('data-region');
      const relations = nodo.getAttribute('data-relations');
      modalTitle.innerText = `Relaciones de ${region}`;
      
      // Limpiar el contenido anterior
      modalRelations.innerHTML = '';

      // Verificar si relations es un array JSON o una cadena simple
      try {
        const relationsList = JSON.parse(relations);
        // Si es un array, crear un elemento li para cada item
        if (Array.isArray(relationsList)) {
          relationsList.forEach(relation => {
            const li = document.createElement('li');
            li.textContent = relation;
            modalRelations.appendChild(li);
          });
        }
      } catch (e) {
        // Si no es JSON, dividir por comas y crear elementos li
        const relationItems = relations.split(',');
        relationItems.forEach(relation => {
          const li = document.createElement('li');
          li.textContent = relation.trim();
          modalRelations.appendChild(li);
        });
      }

      modal.style.display = 'flex';
      setTimeout(() => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
      }, 0);
    });
  });

  closeModal.addEventListener('click', () => {
    modal.classList.add('opacity-0', 'pointer-events-none');
    setTimeout(() => {
      modal.style.display = 'none';
    }, 300);
  });

  modal.addEventListener('click', (event) => {
    if (event.target === modal) {
      closeModal.click();
    }
  });
</script>

<style>
  #modal-relations li {
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  #modal-relations li:last-child {
    margin-bottom: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    interface GraphNode extends HTMLElement {
        dataset: {
            region: string;
            relations: string;
        };
    }

    const filters = document.querySelectorAll<HTMLInputElement>('.filter');
    const nodes = document.querySelectorAll<GraphNode>('.nodo');
    const edges = document.querySelectorAll<SVGLineElement>('line');

    // Grafo dinámico representado como un objeto
    interface Graph {
        nodes: Map<string, GraphNode>;
        edges: Set<SVGLineElement>;
        relations: Map<string, Set<string>>;  // Relaciona nodos entre sí
    }

    const graph: Graph = {
        nodes: new Map(),
        edges: new Set(),
        relations: new Map(),
    };

    // Función para construir el grafo con las conexiones iniciales
    const buildGraph = () => {
        nodes.forEach(node => {
            graph.nodes.set(node.dataset.region, node);
            graph.relations.set(node.dataset.region, new Set(node.dataset.relations.split(',').map(r => r.trim())));
        });

        edges.forEach(edge => {
            graph.edges.add(edge);
        });
    };

    // Función para encontrar los nodos conectados según los filtros
    const findConnectedNodes = (selectedRegions: string[]): Set<GraphNode> => {
        const visibleNodes = new Set<GraphNode>();

        if (selectedRegions.length === 0 || selectedRegions.length === filters.length) {
            graph.nodes.forEach(node => visibleNodes.add(node));
            return visibleNodes;
        }

        selectedRegions.forEach(region => {
            if (graph.nodes.has(region)) {
                visibleNodes.add(graph.nodes.get(region)!);
            }
        });

        return visibleNodes;
    };

    // Función para actualizar la visibilidad del grafo dinámico
    const updateGraphVisualization = () => {
        const checkedFilters = Array.from(filters)
            .filter(filter => filter.checked)
            .map(filter => filter.value);

        const visibleNodes = findConnectedNodes(checkedFilters);

        // Actualizar visibilidad de nodos
        graph.nodes.forEach((node) => {
            if (visibleNodes.has(node)) {
                node.style.display = 'block';
                node.style.opacity = '1';
            } else {
                node.style.display = 'none';
                node.style.opacity = '0';
            }
        });

        // Actualizar visibilidad de aristas
        graph.edges.forEach(edge => {
            // Obtener los nodos conectados por la arista usando atributos 'data-node1' y 'data-node2'
            const node1Region = edge.getAttribute('data-node1');
            const node2Region = edge.getAttribute('data-node2');

            if (node1Region && node2Region) {
                const node1 = graph.nodes.get(node1Region);
                const node2 = graph.nodes.get(node2Region);

                if (node1 && node2) {
                    // Las aristas se muestran solo si ambos nodos están visibles
                    const isVisible = visibleNodes.has(node1) && visibleNodes.has(node2);
                    if (isVisible) {
                        edge.style.display = 'block';   // Mostrar la arista
                        edge.style.opacity = '1';       // Mostrar con opacidad completa
                    } else {
                        edge.style.display = 'none';    // Ocultar la arista
                        edge.style.opacity = '0';       // Establecer opacidad cero
                    }
                }
            }
        });
    };

    // Event listeners para los filtros
    filters.forEach(filter => {
        filter.addEventListener('change', updateGraphVisualization);
    });

    // Event listener para el botón de reset
    const resetButton = document.getElementById('reset-filters');
    if (resetButton) {
        resetButton.addEventListener('click', () => {
            filters.forEach(filter => filter.checked = true);
            updateGraphVisualization();
        });
    }

    // Construir el grafo al cargar la página
    buildGraph();
    updateGraphVisualization();
  });
</script>

