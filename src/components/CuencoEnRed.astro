<!-- Modal -->
<div id="modal" class="fixed inset-0 z-20 hidden justify-center items-center bg-black bg-opacity-50 transition-opacity duration-300 opacity-0 pointer-events-none">
  <div class="bg-white rounded-lg p-4 max-w-sm w-full">
    <h2 id="modal-title" class="text-lg font-semibold text-center"></h2>
    <h3 id="modal-subtitle" class="text-base text-black font-bold mt-2">Sinergias</h3>
    <ul id="modal-relations" class="mt-2 list-disc pl-5"></ul>
    <h3 id="modal-subtitle2" class="text-base text-black font-bold mt-2">Dependencias</h3>
    <ul id="modal-dependencies" class="mt-2 list-disc pl-5"></ul>
    <button id="close-modal" class="mt-4 bg-[#3C499E] text-white py-2 px-4 rounded">Cerrar</button>
  </div>
</div>

<script>
  const nodos = document.querySelectorAll('.nodo');
  const tooltip = document.getElementById('tooltip');
  const modal = document.getElementById('modal');
  const modalTitle = document.getElementById('modal-title');
  const modalRelations = document.getElementById('modal-relations');
  const modalDependencies = document.getElementById('modal-dependencies');
  const closeModal = document.getElementById('close-modal');

  nodos.forEach(nodo => {
    nodo.addEventListener('mouseover', (event) => {
      const region = nodo.getAttribute('data-region');
      tooltip.innerText = region;

      const htmlNodo = nodo as HTMLElement;
      tooltip.style.left = `${htmlNodo.offsetLeft + htmlNodo.offsetWidth + 5}px`;
      tooltip.style.top = `${htmlNodo.offsetTop}px`;
      
      tooltip.classList.remove('hidden');
    });

    nodo.addEventListener('mouseout', () => {
      tooltip.classList.add('hidden');
    });

    nodo.addEventListener('click', () => {
      const region = nodo.getAttribute('data-region');
      const relations = nodo.getAttribute('data-relations');
      const dependencies = nodo.getAttribute('data-dependencies'); 

      modalTitle.innerText = `Enlaces con ${region}`;
      
      
      
      // Limpiar el contenido anterior
      modalRelations.innerHTML = '';
      modalDependencies.innerHTML = '';

      // Verificar si relations es un array JSON o una cadena simple
      try {
        const relationsList = JSON.parse(relations);
        // Si es un array, crear un elemento li para cada item
        if (Array.isArray(relationsList)) {
          relationsList.forEach(relation => {
            const li = document.createElement('li');
            li.textContent = relation;
            modalRelations.appendChild(li);
          });
        }
        
      } catch (e) {
        // Si no es JSON, dividir por comas y crear elementos li
        const relationItems = relations.split(',');
        relationItems.forEach(relation => {
          const li = document.createElement('li');
          li.textContent = relation.trim();
          modalRelations.appendChild(li);
        });
      }

      //Nuevo: Procesar dependencias
      try {
        const dependenciesList = JSON.parse(dependencies);
        if (Array.isArray(dependenciesList)) {
          dependenciesList.forEach(dep => {
            const li = document.createElement('li');
            li.textContent = dep;
            modalDependencies.appendChild(li);
          });
        }
      } catch (e) {
        const dependencyItems = dependencies.split(',');
        dependencyItems.forEach(dep => {
          const li = document.createElement('li');
          li.textContent = dep.trim();
          modalDependencies.appendChild(li);
        });
      }


      modal.style.display = 'flex';
      setTimeout(() => {
        modal.classList.remove('opacity-0', 'pointer-events-none');
      }, 0);
    });
  });

  closeModal.addEventListener('click', () => {
    modal.classList.add('opacity-0', 'pointer-events-none');
    setTimeout(() => {
      modal.style.display = 'none';
    }, 300);
  });

  modal.addEventListener('click', (event) => {
    if (event.target === modal) {
      closeModal.click();
    }
  });
</script>

<style>
  #modal-relations li {
    margin-bottom: 0.5rem;
    line-height: 1.4;
  }

  #modal-relations li:last-child {
    margin-bottom: 0;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    interface GraphNode extends HTMLElement {
        dataset: {
            region: string;
            relations: string;
        };
    }

    const filters = document.querySelectorAll<HTMLInputElement>('.filter');
    const nodes = document.querySelectorAll<GraphNode>('.nodo');
    const edges = document.querySelectorAll<SVGLineElement>('line');

    // Grafo dinámico representado como un objeto
    interface Graph {
        nodes: Map<string, GraphNode>;
        edges: Set<SVGLineElement>;
        relations: Map<string, Set<string>>;  // Relaciona nodos entre sí
    }

    const graph: Graph = {
        nodes: new Map(),
        edges: new Set(),
        relations: new Map(),
    };

    // Función para construir el grafo con las conexiones iniciales
    const buildGraph = () => {
        nodes.forEach(node => {
            graph.nodes.set(node.dataset.region, node);
            graph.relations.set(node.dataset.region, new Set(node.dataset.relations.split(',').map(r => r.trim())));
        });

        edges.forEach(edge => {
            graph.edges.add(edge);
        });
    };

    // Función para encontrar los nodos conectados según los filtros
    const findConnectedNodes = (selectedRegions: string[]): Set<GraphNode> => {
        const visibleNodes = new Set<GraphNode>();

        if (selectedRegions.length === 0 || selectedRegions.length === filters.length) {
            graph.nodes.forEach(node => visibleNodes.add(node));
            return visibleNodes;
        }

        selectedRegions.forEach(region => {
            if (graph.nodes.has(region)) {
                visibleNodes.add(graph.nodes.get(region)!);
            }
        });

        return visibleNodes;
    };

    // Función para actualizar la visibilidad del grafo dinámico
    const updateGraphVisualization = () => {
        const checkedFilters = Array.from(filters)
            .filter(filter => filter.checked)
            .map(filter => filter.value);

        const visibleNodes = findConnectedNodes(checkedFilters);

        // Actualizar visibilidad de nodos
        graph.nodes.forEach((node) => {
            if (visibleNodes.has(node)) {
                node.style.display = 'block';
                node.style.opacity = '1';
            } else {
                node.style.display = 'none';
                node.style.opacity = '0';
            }
        });

        // Actualizar visibilidad de aristas
        graph.edges.forEach(edge => {
            // Obtener los nodos conectados por la arista usando atributos 'data-node1' y 'data-node2'
            const node1Region = edge.getAttribute('data-node1');
            const node2Region = edge.getAttribute('data-node2');

            if (node1Region && node2Region) {
                const node1 = graph.nodes.get(node1Region);
                const node2 = graph.nodes.get(node2Region);

                if (node1 && node2) {
                    // Las aristas se muestran solo si ambos nodos están visibles
                    const isVisible = visibleNodes.has(node1) && visibleNodes.has(node2);
                    if (isVisible) {
                        edge.style.display = 'block';   // Mostrar la arista
                        edge.style.opacity = '1';       // Mostrar con opacidad completa
                    } else {
                        edge.style.display = 'none';    // Ocultar la arista
                        edge.style.opacity = '0';       // Establecer opacidad cero
                    }
                }
            }
        });
    };

    // Event listeners para los filtros
    filters.forEach(filter => {
        filter.addEventListener('change', updateGraphVisualization);
    });

    // Event listener para el botón de reset
    const resetButton = document.getElementById('reset-filters');
    if (resetButton) {
        resetButton.addEventListener('click', () => {
            filters.forEach(filter => filter.checked = true);
            updateGraphVisualization();
        });
    }

    // Construir el grafo al cargar la página
    buildGraph();
    updateGraphVisualization();
  });
</script>

<!-- Productos academicos de participantes en red -->
<div class="w-full flex flex-col items-center justify-center bg-zinc-100 p-4 sm:p-6 md:p-8 lg:p-10 rounded-t-xl px-4 sm:px-8 md:px-16 lg:px-32">
