---
const { class: className } = Astro.props;
---

<div class={`${className}mx-auto w-10/12 mt-10`}>

  <div class="flex flex-wrap gap-4 mb-4">
    <div class="flex items-center">
        <div style="width: 12px; height: 12px; background-color: #666; border-radius: 2px;"></div>
        <span class="text-gray-800 font-medium">&nbsp;&nbsp;IIEDU: Instituto de Investigación en Educación</span>
    </div>
    <div class="flex items-center">
        <div style="width: 12px; height: 12px; background-color: #666; border-radius: 2px;"></div>
        <span class="text-gray-800 font-medium">&nbsp;&nbsp;EIA: Ecosistema de Innovación Académica</span>
    </div>
    <div class="flex items-center">
        <div style="width: 12px; height: 12px; background-color: #666; border-radius: 2px;"></div>
        <span class="text-gray-800 font-medium">&nbsp;&nbsp;DNIA: Dirección Nacional de Innovación Académica</span>
    </div>
  </div>



  <div class="row">
    <div class="col-12 col-md-8">
      <img
        class="img-thumbnail rounded-lg"
        src="/img-cuenco/mapas/map-00.webp"
        alt=""
      />
    </div>
    <div class="col-12 col-md-4">
      <div class="col-12 mt-map">
        <img
          class="img-thumbnail rounded-lg"
          src="/img-cuenco/mapas/map-01.webp"
          alt=""
        />
      </div>
      <div class="col-12 mt-8">
        <img
          class="img-thumbnail rounded-lg"
          src="/img-cuenco/mapas/map-02.webp"
          alt=""
        />
      </div>
    </div>
  </div>

  <div class="row mt-8">
    <div class="col-md-4">
      <img
        class="img-thumbnail rounded-lg"
        src="/img-cuenco/mapas/map-03.webp"
        alt=""
      />
    </div>
    <div class="col-md-4 mt-map">
      <img
        class="img-thumbnail rounded-lg"
        src="/img-cuenco/mapas/map-04.webp"
        alt=""
      />
    </div>
    <div class="col-md-4 mt-map">
      <img
        class="img-thumbnail rounded-lg"
        src="/img-cuenco/mapas/map-05.webp"
        alt=""
      />
    </div>
  </div>
  
  <div class="row mt-8">
    <div class="col-md-4 mt-map">
      <img
        class="img-thumbnail rounded-lg"
        src="/img-cuenco/mapas/map-06.webp"
        alt=""
      />
    </div>

    <div class="col-md-4 mt-map">
      <img
        class="img-thumbnail rounded-lg"
        src="/img-cuenco/mapas/map-07.webp"
        alt=""
      /> 
    </div>
    <div class="col-md-4 mt-map">
      <img
        class="img-thumbnail rounded-lg"
        src="/img-cuenco/mapas/map-08.webp"
        alt=""
      /> 
    </div>
  </div>

  <div class="row mt-8">
    <div class="col-md-4 mt-map">
      <img
        class="img-thumbnail rounded-lg"
        src="/img-cuenco/mapas/map-09.webp"
        alt=""
      />
    </div>
    <div class="col-md-4 mt-map">
      <img
        class="img-thumbnail rounded-lg"
        src="/img-cuenco/mapas/map-10.webp"
        alt=""
      /> 
    </div>
  </div>
</div>


<style>
  img:hover {
    cursor: pointer;
    box-shadow: 0 0 10px rgba(0, 0, 0, 0.5);
    transition: all ease 0.4s;
    transform: scale(1.03);
  }
  @media screen and (max-width: 991px) {
    .mt-map {
      margin-top: 2rem;
    }  
  }
  
</style>
