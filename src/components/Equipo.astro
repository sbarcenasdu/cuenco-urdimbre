---

<div id={id} class={`w-full md:order-0 ${className}`}>
  <div class="py-4 px-4 md:px-20 pb-10">
    <div class="publicaciones grid grid-cols-1 md:grid-cols-3 gap-5">
      {miembros.map((miembro) => (
        <div class="equipo flex flex-col items-center">
          <img 
            src={miembro.imagen} 
            alt={miembro.nombre} 
            style={{ height: '80px', width: '80px', borderRadius: '50%', objectFit: 'cover'}}
            class="shadow-md mb-4"
          />
          <h2 class="text-custom font-semibold">{miembro.nombre}</h2>
          <p class="font-medium text-black">{miembro.cargo}</p>
        </div>
      ))} 
    </div>
  </div>
</div>

<style>
  .equipo {
    border: none;
    padding: 1rem;
    text-align: center;
  }

  .equipo h2 {
    font-size: 1.5rem;
    margin-bottom: 5px;
  }

  .equipo p {
    font-size: 1rem;
    line-height: 1.5;
  }

  .text-custom {
    font-size: 1rem !important; /* Ajusta este valor según sea necesario */
}

</style>
